// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VisitSource {
  IPAD
  STAFF
}

model Customer {
  id              String        @id @default(cuid())
  name            String
  phone           String?
  normalizedPhone String?       @unique
  email           String?
  normalizedEmail String?       @unique
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  visits          Visit[]
  appointments    Appointment[]
  consents        Consent[]

  @@index([name])
}

model Service {
  id                  String               @id @default(cuid())
  name                String
  priceDefault        Int?
  imageUrl            String?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  visitServices       VisitService[]
  appointmentServices AppointmentService[]

  @@unique([name])
}

model Visit {
  id              String         @id @default(cuid())
  customerId      String
  visitAt         DateTime       @default(now())
  amountPaidCents Int?
  paymentMethod   String?
  notes           String?
  source          VisitSource    @default(IPAD)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visitServices   VisitService[]
  consent         Consent?

  @@index([customerId, visitAt])
}

// Signed client consent + liability waiver captured at check-in.
// One record per signing; formVersion pins the exact text the client agreed to.
// See lib/consent.ts for the current version and wording.
model Consent {
  id          String  @id @default(cuid())
  customerId  String
  visitId     String? @unique
  formVersion String

  // Intake + acknowledgments stored as JSON so the questionnaire can evolve
  // without a migration. Shapes are defined in lib/consent.ts.
  healthHistory   Json?
  acknowledgments Json?

  releaseAccepted Boolean @default(false)

  // Signature: typed legal name is the operative UETA signature; the drawn
  // image (data URL) is optional supporting evidence.
  signatureName  String
  signatureType  String  @default("typed") // "typed" | "drawn"
  signatureImage String?

  // Minor handling (parent/guardian signs; see lib/consent.ts caveats).
  isMinor      Boolean @default(false)
  guardianName String?

  // Separate, optional marketing/photo release.
  photoConsent Boolean @default(false)

  // Evidentiary metadata to strengthen the electronic signature.
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visit    Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([formVersion])
}

model VisitService {
  id          String   @id @default(cuid())
  visitId     String
  serviceId   String
  serviceName String
  priceCents  Int?
  createdAt   DateTime @default(now())
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, serviceId])
  @@index([serviceId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

model Appointment {
  id              String            @id @default(cuid())
  customerId      String?
  name            String
  email           String
  phone           String
  scheduledAt     DateTime
  endTime         DateTime?
  status          AppointmentStatus @default(PENDING)
  totalPriceCents Int?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customer Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  services AppointmentService[]

  @@index([scheduledAt])
}

model AppointmentService {
  id            String   @id @default(cuid())
  appointmentId String
  serviceId     String
  serviceName   String
  priceCents    Int?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@index([serviceId])
}

model ScheduleRule {
  id        String   @id @default(cuid())
  date      String   @unique
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
